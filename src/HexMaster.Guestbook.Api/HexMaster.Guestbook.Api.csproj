<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Container image metadata (also enforced in the Dockerfile / CI workflow):
       image is named global-guestbook/guestbook-api and runs as the non-root
       "app" user (APP_UID) so it never runs under a privileged account. The
       version tag is supplied by the GitHub Actions workflow (semantic versioning). -->
  <PropertyGroup>
    <ContainerRepository>global-guestbook/guestbook-api</ContainerRepository>
    <ContainerUser>app</ContainerUser>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.Azure.Cosmos" Version="13.5.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aspire\HexMaster.Guestbook.Aspire\HexMaster.Guestbook.Aspire.ServiceDefaults\HexMaster.Guestbook.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\HexMaster.Guestbook.Abstractions\HexMaster.Guestbook.Abstractions.csproj" />
    <ProjectReference Include="..\HexMaster.Guestbook\HexMaster.Guestbook.csproj" />
    <ProjectReference Include="..\HexMaster.Guestbook.Data.CosmosDb\HexMaster.Guestbook.Data.CosmosDb.csproj" />
    <ProjectReference Include="..\Core\HexMaster.Guestbook.Core\HexMaster.Guestbook.Core.csproj" />
  </ItemGroup>

</Project>
