<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HexMaster.Guestbook.Abstractions\HexMaster.Guestbook.Abstractions.csproj" />
    <ProjectReference Include="..\Core\HexMaster.Guestbook.Core\HexMaster.Guestbook.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- The IP → country dataset is embedded in the assembly (gzip-compressed to stay
       well under GitHub's 100 MB file limit) and parsed into an in-memory lookup at
       startup (CsvClientLocationResolver). No external database or download is required.
       Format per row (decompressed): type,startNum,endNum,CC  e.g. 4,16778240,16779263,AU -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\GeoIp.csv.gz" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HexMaster.Guestbook.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
